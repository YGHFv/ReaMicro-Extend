{
  "hookPath": "app/src/main/java/com/reamicro/fix/hook/ReaMicroSettingsHook.kt",
  "className": "ReaMicroSettingsHook",
  "subPackage": "com.reamicro.fix.hook.settings",
  "keepInClass": ["install"],
  "commonFooter": [
    "//",
    "// 从 ReaMicroSettingsHook 机械外移而来，函数体逐字未改：搬迁脚本会把反缩进后的",
    "// 结果重新缩进回去与原文逐字节比对，不一致直接中止（tools/extract-hook-cluster.mjs）。"
  ],
  "clusters": [
    {
      "id": "HostHooks",
      "match": "^hook[A-Z]",
      "header": [
        "// ReaMicroSettingsHook 的宿主 hook 安装簇。",
        "//",
        "// 所有 hookXxx()：把模块的设置项挂进宿主设置页的列表与导航图。"
      ]
    },
    {
      "id": "Highlight",
      "match": "highlight",
      "header": [
        "// 阅读页高亮设置簇。",
        "//",
        "// 高亮样式与规则的列表页、编辑弹窗、颜色选择、预览绘制，以及从阅读页唤起的",
        "// 高亮规则面板。"
      ]
    },
    {
      "id": "EpubStyle",
      "match": "epubstyle|onlineepub",
      "header": [
        "// 在线补全 EPUB 样式设置簇。",
        "//",
        "// 样式的增删改、CSS 分段编辑、实时预览、导入导出与配图选择。"
      ]
    },
    {
      "id": "OnlineSource",
      "match": "onlinesource|trxs|sourcelogin|associationsource|searchsource",
      "header": [
        "// 在线源与关联补全源的设置簇。",
        "//",
        "// 书源导入、启用停用、登录授权（含 trxs 类源的 JS 登录适配）。"
      ]
    },
    {
      "id": "Background",
      "match": "profilebackground|readerbackground|background",
      "header": [
        "// 我的页背景与阅读页背景的设置簇。",
        "//",
        "// 颜色与图片选择、裁剪位置、显示模式、模糊与透明度。"
      ]
    },
    {
      "id": "ReadAloud",
      "match": "readaloud|tts|voice",
      "header": [
        "// 朗读设置簇。",
        "//",
        "// 朗读引擎与音色选择、翻页重启、音频焦点、Lyricon 歌词卡片开关。"
      ]
    },
    {
      "id": "AiConfig",
      "match": "aiapi|aidictionary|aiimage|^ai[A-Z]",
      "header": [
        "// AI 接口设置簇。",
        "//",
        "// AI 服务的接入配置、词典预设与配图预设。"
      ]
    },
    {
      "id": "Font",
      "match": "font",
      "header": [
        "// 字体设置簇。",
        "//",
        "// 全局界面字体与阅读正文字体的导入、选择、按文本样式分别指定。"
      ]
    },
    {
      "id": "Dialogs",
      "match": "settingsdialog|dialog|picker",
      "header": [
        "// 设置页弹窗构件簇。",
        "//",
        "// 与宿主风格一致的对话框卡片、标题、选项行、按钮、滚动容器，以及文件选择器。"
      ]
    },
    {
      "id": "SettingsUi",
      "match": "render|route|nav|topbar|lazyitem|insert|entry|screen|content|card|row",
      "header": [
        "// 设置页界面渲染簇。",
        "//",
        "// 注入到宿主 NavHost 的各个设置页面、顶栏、列表项与卡片。"
      ]
    },
    {
      "id": "Support",
      "match": "*",
      "header": [
        "// 设置页的支撑簇。",
        "//",
        "// 反射调用宿主 Compose 构件、取宿主主题色与排版、日志导出、以及各类小工具。"
      ]
    }
  ]
}
