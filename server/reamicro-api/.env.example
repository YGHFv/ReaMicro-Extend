REAMICRO_SERVER_ID=reamicro-api
# 留空表示公开访问；生产环境建议设置随机长密钥。
REAMICRO_API_KEY=
REAMICRO_ALLOW_PUBLIC=true
REAMICRO_FEATURES=association_source,theme_library,style_library,book_source_library,backup,module_update
REAMICRO_MIN_MODULE_VERSION=2.0.0
# X.509 DER 格式 Ed25519 公钥的 Base64；留空时客户端允许未签名包，生产环境必须配置。
REAMICRO_SIGNING_PUBLIC_KEY=
REAMICRO_GITHUB_REPOSITORY=YGHFv/ReaMicro-Extend
# 私有仓库或提高 GitHub API 限额时填写。
REAMICRO_GITHUB_TOKEN=
REAMICRO_GITHUB_INCLUDE_PRERELEASE=false
# 可选：GitHub Release Webhook 的 Secret；设置后将 /v1/webhooks/github 配置到 GitHub。
REAMICRO_GITHUB_WEBHOOK_SECRET=
REAMICRO_RELEASE_SYNC_SECONDS=1800
# 可选；设置后客户端优先使用 versionCode 判断更新。
REAMICRO_RELEASE_VERSION_CODE=0
REAMICRO_CONFIG_ROOT=/data/config
REAMICRO_ADMIN_USERNAME=admin
# 首次初始化主管理员的一次性引导密码；首次完成 /admin 初始化后该值不再用于登录。
# 建议使用至少 20 位随机值；留空时无法初始化后台。
REAMICRO_ADMIN_PASSWORD=
# 后台 Cookie 会话有效期（秒），默认 12 小时；生产环境必须通过 HTTPS 使用 Secure Cookie。
REAMICRO_ADMIN_SESSION_SECONDS=43200
REAMICRO_ADMIN_COOKIE_SECURE=true
# 可选：容器内 Ed25519 PEM 私钥路径，配置后后台上传内容包会自动签名。
REAMICRO_SIGNING_PRIVATE_KEY_FILE=
REAMICRO_TASK_ROOT=/data/tasks
REAMICRO_STATE_DB=/data/state/reamicro.sqlite3
REAMICRO_SECRET_KEY=
REAMICRO_SECRET_BACKUP_ROOT=/data/backups/secrets
REAMICRO_SERVER_BACKUP_ROOT=/data/backups/server
REAMICRO_SERVER_SNAPSHOT_ENABLED=true
REAMICRO_SERVER_SNAPSHOT_SECONDS=86400
REAMICRO_SERVER_SNAPSHOT_RETENTION=30
REAMICRO_AUDIT_ROOT=/data/audit
# 单客户端/路径每分钟请求上限，建议公网部署按实际情况调整。
REAMICRO_RATE_LIMIT=120
# API 和 Worker 分离时，API=false、Worker=true；单容器兼容部署可保持 true。
REAMICRO_RUN_SCHEDULER=true
REAMICRO_RUN_RELEASE_SYNC=true
# Watchtower 检查 GHCR 镜像的间隔（秒），默认 5 分钟。
REAMICRO_IMAGE_UPDATE_INTERVAL=300
