<resources>
    <!--
      application 默认主题，供非主界面组件使用。
      主界面冷启动另用独立的 Theme.App.Starting，背景沿用手机 DeviceDefault 默认值；
      Android 12+ 开屏提供柳梢青前景；桌面图标仍按用户选择的 launcher 别名显示。
    -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <style name="NoDisplayTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowNoDisplay">false</item>
    </style>

    <!--
      模块主界面的主题。浅色版本在这里，深色版本在 values-night/styles.xml——两个资源目录按系统的
      深浅色自动切换，于是窗口底色跟着系统走；页面内部的配色由 ModuleDialogTheme.palette() 依据
      uiMode 推导，同样跟随系统。窗口底色写死颜色是为了避免启动瞬间闪一下系统默认白/黑。
    -->
    <style name="ModuleTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF4F5F7</item>
    </style>
    <!-- Full-screen module Compose island: background draws behind system bars, controls consume insets. -->
    <style name="EpubFullScreenDialog" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Starting-window themes: device defaults; no background overrides. -->
    <!-- Device defaults only; let the ROM supply the background. No app palette or fixed color. -->
    <style name="Theme.App.StartingBase" parent="android:style/Theme.DeviceDefault.Light.NoActionBar" />
    <style name="Theme.App.Starting" parent="@style/Theme.App.StartingBase" />
</resources>
