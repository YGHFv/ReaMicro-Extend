<resources>
    <!--
      application 级主题。已完全移除自定义启动页（SplashScreen）配置：
      启动图标由系统按当前生效的 launcher 别名（用户所选配色那套）显示，不再有任何固定遮罩。
      windowBackground 仅留一层纯底色，避免冷启动首帧闪系统默认背景。
    -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <style name="NoDisplayTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowNoDisplay">false</item>
    </style>

    <!--
      模块主界面的主题。浅色版本在这里，深色版本在 values-night/styles.xml——两个资源目录按系统的
      深浅色自动切换，于是窗口底色跟着系统走；页面内部的配色由 ModuleDialogTheme.palette() 依据
      uiMode 推导，同样跟随系统。窗口底色写死颜色是为了避免启动瞬间闪一下系统默认白/黑。
    -->
    <style name="ModuleTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF4F5F7</item>
    </style>
    <!-- Full-screen module Compose island: background draws behind system bars, controls consume insets. -->
    <style name="EpubFullScreenDialog" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>