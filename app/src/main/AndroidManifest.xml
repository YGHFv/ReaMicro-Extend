<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      miuix-blur 库把 minSdk 声明成 33（RuntimeShader 需要 Android 13）。库内所有效果路径都有
      isRuntimeShaderSupported()（SDK_INT >= 33）运行时门禁，低版本设备只是没有效果、不会崩；
      模块自己的调用侧同样先查这个开关再挂玻璃层，所以放行合并。
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Android 12+ 不申请 SCHEDULE_EXACT_ALARM 时 canScheduleExactAlarms() 恒为 false，
      云任务闹钟会降级到 setAndAllowWhileIdle——该 API 在 Doze 下可能被推迟数小时。
      USE_EXACT_ALARM（Android 13+）适用于闹钟/日程类应用，声明后系统默认授予、
      用户不能撤销；SCHEDULE_EXACT_ALARM 作为 12 及部分 13 ROM 的回退，需要用户手动授权。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <package android:name="app.zhendong.reamicro" />
        <package android:name="com.reamicro.fix" />
        <!-- 厂商自启动设置页：主界面要能跳到它们。Android 11+ 起隐式 Intent 需要包可见性，
             否则解析不到会静默失败（各 ROM 的组件名见 RootWakeController 附近的候选列表与
             ModuleMainActivity.openAutoStartSettings）。 -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.huawei.systemmanager" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/module_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:resource="@string/module_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="lyricon_module"
            android:value="true" />
        <meta-data
            android:name="lyricon_module_author"
            android:value="ReaMicro Extend" />
        <meta-data
            android:name="lyricon_module_description"
            android:value="Send ReaMicro read-aloud captions to Lyricon" />

        <provider
            android:name=".cloud.api.ModuleApkContentProvider"
            android:authorities="com.reamicro.fix.module-apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name=".cloud.api.ApiServerSettingsBridgeProvider"
            android:authorities="com.reamicro.fix.api-settings"
            android:exported="true" />

        <receiver
            android:name=".notification.OnlineCompletionNotificationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.ONLINE_COMPLETION_NOTIFICATION" />
                <action android:name="com.reamicro.fix.ONLINE_COMPLETION_CANCEL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notification.CloudTaskNotificationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.CLOUD_TASK_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- exported=true：闹钟与宿主的重排请求都由阅微进程显式投递到这里，非导出会被系统拒收。 -->
        <receiver
            android:name=".cloud.api.CloudTaskHeartbeatReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.CLOUD_TASK_HEARTBEAT" />
                <action android:name="com.reamicro.fix.KSU_TASK_SYNC" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".cloud.local.LocalTaskJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 宿主进程自己排不了闹钟：它排出来的是阅微名下的模糊闹钟，且写不进模块的唤醒时刻文件。
             这里只重排、不执行任务。 -->
        <receiver
            android:name=".cloud.api.CloudTaskRescheduleReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.RESCHEDULE_WAKE" />
            </intent-filter>
        </receiver>

        <!-- 接收宿主（阅微进程）下发的本地任务配置。explicit component + 带
             FLAG_INCLUDE_STOPPED_PACKAGES 的广播才能投递到未启动过的模块，而 provider 做不到。 -->
        <receiver
            android:name=".cloud.local.LocalTaskMirrorReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.LOCAL_TASK_MIRROR" />
            </intent-filter>
        </receiver>

        <!-- 同上，但下发的是 API 服务器配置：模块进程要用它去服务器拉消息并回执。
             原来的 provider 通道在模块处于 stopped 时无法被解析，故改走广播。 -->
        <receiver
            android:name=".cloud.api.ApiServerSettingsMirrorReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.API_SETTINGS_MIRROR" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".tts.ReadAloudCommandReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.READ_ALOUD_PREPARE" />
                <action android:name="com.reamicro.fix.READ_ALOUD_APPEND" />
                <action android:name="com.reamicro.fix.READ_ALOUD_PLAY" />
                <action android:name="com.reamicro.fix.READ_ALOUD_PAUSE" />
                <action android:name="com.reamicro.fix.READ_ALOUD_RESUME" />
                <action android:name="com.reamicro.fix.READ_ALOUD_STOP" />
                <action android:name="com.reamicro.fix.READ_ALOUD_PREV" />
                <action android:name="com.reamicro.fix.READ_ALOUD_NEXT" />
                <action android:name="com.reamicro.fix.READ_ALOUD_SYNC_PROGRESS" />
            </intent-filter>
        </receiver>

        <!-- 模块自己的主界面。此前模块没有任何 launcher activity，装完可能长期处于 stopped 状态，
             而 stopped 应用的广播收不到——系统闹钟唤醒正是靠广播。有了它，用户装完会打开一次，
             应用即脱离 stopped；界面本身也是查看任务记录/通知记录/诊断日志的入口。 -->
        <activity
            android:name=".ui.ModuleMainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/module_name"
            android:theme="@style/ModuleTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".notification.OnlineCompletionNotificationActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/NoDisplayTheme" />

        <activity
            android:name=".notification.CloudTaskNotificationActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/NoDisplayTheme" />

        <activity
            android:name=".importer.SourceImportActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/module_name"
            android:theme="@style/NoDisplayTheme">
            <intent-filter android:label="@string/module_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter android:label="@string/module_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.json" />
            </intent-filter>
            <intent-filter android:label="@string/module_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <activity
            android:name=".tts.ReadAloudCommandActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/NoDisplayTheme" />


        <service
            android:name=".notification.OnlineCompletionNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".tts.ReadAloudService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
