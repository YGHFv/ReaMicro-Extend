<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Effects are gated at API 33; older devices keep the app's solid-surface UI. -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur,top.yukonga.miuix.kmp.glass" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="app.zhendong.reamicro" />
        <package android:name="app.zhendong.reamicro.fix" />
        <package android:name="com.reamicro.fix" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".RootEnhancementApplication"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/module_name"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="true">

        <receiver android:name=".cloud.root.RootTaskSyncReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.reamicro.fix.ROOT_TASK_SYNC" />
            </intent-filter>
        </receiver>
        <receiver android:name=".notification.RootTaskProgressReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity android:name=".notification.RootTaskProgressActivity" android:exported="true"
            android:permission="android.permission.DUMP" android:excludeFromRecents="true"
            android:taskAffinity="" android:theme="@style/NoDisplayTheme" />
        <receiver android:name=".migration.PackageUpgradeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <provider
            android:name=".cloud.api.ModuleApkContentProvider"
            android:authorities="com.reamicro.fix.module-apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name=".cloud.api.ApiServerSettingsBridgeProvider"
            android:authorities="com.reamicro.fix.api-settings"
            android:exported="true"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".notification.OnlineCompletionNotificationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.ONLINE_COMPLETION_NOTIFICATION" />
                <action android:name="com.reamicro.fix.ONLINE_COMPLETION_CANCEL" />
                <action android:name="com.reamicro.fix.ONLINE_COMPLETION_PAUSE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notification.CloudTaskNotificationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.CLOUD_TASK_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".cloud.api.ApiServerSettingsMirrorReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.API_SETTINGS_MIRROR" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".reload.HotReloadProvider"
            android:authorities="com.reamicro.fix.hot-reload"
            android:grantUriPermissions="true"
            android:exported="true" />
        <receiver android:name=".reload.HotReloadWakeReceiver" android:exported="true" />

        <activity
            android:name=".ui.HostRestartActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.reamicro.fix.restart"
            android:configChanges="orientation|screenSize|screenLayout|uiMode"
            android:theme="@style/NoDisplayTheme" />

        <activity
            android:name=".ui.ModuleMainActivity"
            android:enableOnBackInvokedCallback="true"
            android:launchMode="singleTop"
            android:configChanges="locale|layoutDirection|uiMode"
            android:enabled="true"
            android:exported="true"
            android:label="@string/module_name"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ui.ModuleLauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasMono"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_02"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_03"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasNight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_04"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasSky"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_05"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_06"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasRose"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_07"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_08"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasViolet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_09"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasSlate"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_10"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".notification.OnlineCompletionNotificationActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/NoDisplayTheme" />

        <activity
            android:name=".notification.CloudTaskNotificationActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/NoDisplayTheme" />

        <activity
            android:name=".importer.SourceImportActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/module_name"
            android:theme="@style/NoDisplayTheme">
            <intent-filter android:label="@string/module_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter android:label="@string/module_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.json" />
            </intent-filter>
            <intent-filter android:label="@string/module_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <service
            android:name=".notification.OnlineCompletionNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
