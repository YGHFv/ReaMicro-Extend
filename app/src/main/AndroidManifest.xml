<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="app.zhendong.reamicro" />
        <package android:name="com.reamicro.fix" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".RootEnhancementApplication"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/module_name"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="true">
        <!-- Root/shell completion only. Do not let ordinary apps repeatedly trigger su/config sync. -->
        <receiver android:name=".cloud.root.RootTaskSyncReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.reamicro.fix.ROOT_TASK_SYNC" />
            </intent-filter>
        </receiver>
        <receiver android:name=".migration.PackageUpgradeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:resource="@string/module_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="lyricon_module"
            android:value="true" />
        <meta-data
            android:name="lyricon_module_author"
            android:value="ReaMicro Extend" />
        <meta-data
            android:name="lyricon_module_description"
            android:value="Send ReaMicro read-aloud captions to Lyricon" />

        <provider
            android:name=".cloud.api.ModuleApkContentProvider"
            android:authorities="com.reamicro.fix.module-apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name=".cloud.api.ApiServerSettingsBridgeProvider"
            android:authorities="com.reamicro.fix.api-settings"
            android:exported="true" />

        <receiver
            android:name=".notification.OnlineCompletionNotificationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.ONLINE_COMPLETION_NOTIFICATION" />
                <action android:name="com.reamicro.fix.ONLINE_COMPLETION_CANCEL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notification.CloudTaskNotificationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.CLOUD_TASK_NOTIFICATION" />
            </intent-filter>
        </receiver>







        <receiver
            android:name=".cloud.local.LocalTaskMirrorReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.LOCAL_TASK_MIRROR" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".cloud.api.ApiServerSettingsMirrorReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.API_SETTINGS_MIRROR" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".tts.ReadAloudCommandReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.reamicro.fix.READ_ALOUD_PREPARE" />
                <action android:name="com.reamicro.fix.READ_ALOUD_APPEND" />
                <action android:name="com.reamicro.fix.READ_ALOUD_PLAY" />
                <action android:name="com.reamicro.fix.READ_ALOUD_PAUSE" />
                <action android:name="com.reamicro.fix.READ_ALOUD_RESUME" />
                <action android:name="com.reamicro.fix.READ_ALOUD_STOP" />
                <action android:name="com.reamicro.fix.READ_ALOUD_PREV" />
                <action android:name="com.reamicro.fix.READ_ALOUD_NEXT" />
                <action android:name="com.reamicro.fix.READ_ALOUD_SYNC_PROGRESS" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.ModuleMainActivity"
            android:launchMode="singleTop"
            android:configChanges="locale|layoutDirection"
            android:enabled="true"
            android:exported="true"
            android:label="@string/module_name"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ui.ModuleLauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasMono"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_02"
            android:roundIcon="@mipmap/ic_launcher_02_round"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_03"
            android:roundIcon="@mipmap/ic_launcher_03_round"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasNight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_04"
            android:roundIcon="@mipmap/ic_launcher_04_round"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasSky"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_05"
            android:roundIcon="@mipmap/ic_launcher_05_round"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_06"
            android:roundIcon="@mipmap/ic_launcher_06_round"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasRose"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_07"
            android:roundIcon="@mipmap/ic_launcher_07_round"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_08"
            android:roundIcon="@mipmap/ic_launcher_08_round"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasViolet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_09"
            android:roundIcon="@mipmap/ic_launcher_09_round"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.ModuleIconAliasSlate"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_10"
            android:roundIcon="@mipmap/ic_launcher_10_round"
            android:label="@string/module_name"
            android:targetActivity=".ui.ModuleMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".notification.OnlineCompletionNotificationActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/NoDisplayTheme" />

        <activity
            android:name=".notification.CloudTaskNotificationActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/NoDisplayTheme" />

        <activity
            android:name=".importer.SourceImportActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/module_name"
            android:theme="@style/NoDisplayTheme">
            <intent-filter android:label="@string/module_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter android:label="@string/module_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.json" />
            </intent-filter>
            <intent-filter android:label="@string/module_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <activity
            android:name=".tts.ReadAloudCommandActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/NoDisplayTheme" />


        <service
            android:name=".notification.OnlineCompletionNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".tts.ReadAloudService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>